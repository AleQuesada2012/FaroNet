{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "faronet-edge",
  "main": "build/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "send_metrics": false,
  "vars": { "PUBLIC_ROOMS_ENABLED": "false" },
  "durable_objects": {
    "bindings": [{ "name": "PUBLIC_ROOMS", "class_name": "PublicRoom" }]
  },
  "exports": {
    "PublicRoom": { "type": "durable-object", "storage": "sqlite" }
  },
  "build": {
    "command": "npm run build",
    "watch_dir": "src"
  },
  // The assignment requires no persisted traffic/identity logs.
  "observability": {
    "enabled": false,
    "logs": { "enabled": false },
    "traces": { "enabled": false }
  }
  // Public rooms are opt-in for local testing. No remote resources are created
  // by editing this file or running wrangler dev --local.
}
